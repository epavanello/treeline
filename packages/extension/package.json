{
  "name": "treeline",
  "displayName": "Treeline — Git Graph",
  "description": "A fast, minimal Git Graph for VS Code and Cursor, built for branches, worktrees and reviews.",
  "version": "0.11.0",
  "publisher": "epavanello",
  "license": "MIT",
  "author": "Emanuele Pavanello",
  "repository": {
    "type": "git",
    "url": "https://github.com/epavanello/treeline"
  },
  "homepage": "https://github.com/epavanello/treeline#readme",
  "bugs": "https://github.com/epavanello/treeline/issues",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "log",
    "history",
    "worktree"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "treeline.view",
        "title": "View Git Graph",
        "category": "Treeline",
        "icon": "$(git-merge)"
      },
      {
        "command": "treeline.fetch",
        "title": "Fetch from Remote(s)",
        "category": "Treeline"
      },
      {
        "command": "treeline.generateCommitMessage",
        "title": "Generate Commit Message with Claude",
        "category": "Treeline",
        "icon": "$(sparkle)"
      }
    ],
    "configuration": {
      "title": "Treeline",
      "properties": {
        "treeline.claude.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what works with Claude: commit messages (✨ in Source Control), change summaries and Claude Code sessions. They show only when Claude Code (`claude`) is installed, or for commit messages another language model of the editor. Turn it off to hide all of it."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "treeline.generateCommitMessage",
          "when": "treeline.commitMessage"
        }
      ],
      "scm/title": [
        {
          "command": "treeline.generateCommitMessage",
          "when": "scmProvider == git && treeline.commitMessage",
          "group": "navigation"
        },
        {
          "command": "treeline.view",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "check": "tsc --noEmit -p .",
    "test": "vitest run --dir test",
    "package": "vsce package --no-dependencies --out treeline.vsix",
    "fixture": "esbuild scripts/fixture-json.ts --bundle --platform=node --main-fields=module,main --format=esm --outfile=.cache/fixture.mjs --log-level=warning && node .cache/fixture.mjs",
    "e2e": "esbuild e2e/*.test.ts --bundle --platform=node --main-fields=module,main --format=cjs --external:vscode --outdir=.cache/e2e --out-extension:.js=.cjs --log-level=warning && vscode-test",
    "publish": "vsce publish --no-dependencies --packagePath treeline.vsix && ovsx publish treeline.vsix"
  },
  "devDependencies": {
    "@treeline/shared": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "3.3.1",
    "ovsx": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
